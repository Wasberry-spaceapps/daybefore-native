<Window x:Class="DayBefore.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Day Before" Height="600" Width="450"
        Background="#1a1817" Foreground="#e8e4df"
        FontFamily="Georgia, Times New Roman"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Grid.Row="0" Background="#0a0908" MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Day Before" Foreground="#666666" FontSize="12"
                       VerticalAlignment="Center" Margin="12,0,0,0"/>
            <Button Grid.Column="1" Content="×" Style="{StaticResource TitleBarBtn}" Click="Close_Click"/>
        </Grid>

        <!-- Auth content -->
        <Grid Grid.Row="1" Margin="48">
            <!-- Login/Register form -->
            <StackPanel x:Name="AuthPanel" VerticalAlignment="Center">
                <TextBlock Text="Day Before" FontSize="28" Foreground="#e8e4df" Margin="0,0,0,48"/>

                <TextBlock x:Name="FormTitle" Text="Log In" FontSize="18" FontWeight="Medium" Margin="0,0,0,24"/>

                <TextBlock x:Name="ErrorLabel" Text="" Foreground="#e74c3c" FontSize="13" Margin="0,0,0,16" TextWrapping="Wrap"/>

                <TextBox x:Name="EmailBox" Background="Transparent" Foreground="#e8e4df"
                         BorderBrush="#36312d" BorderThickness="1" Padding="12" FontSize="14"
                         Margin="0,0,0,16">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <ScrollViewer x:Name="PART_ContentHost"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <TextBlock Text="Email address" Foreground="#968d86" FontSize="11" Margin="0,-12,0,16"/>

                <PasswordBox x:Name="PasswordBox" Background="Transparent" Foreground="#e8e4df"
                             BorderBrush="#36312d" BorderThickness="1" Padding="12" FontSize="14"
                             Margin="0,0,0,16" KeyDown="Password_KeyDown">
                    <PasswordBox.Style>
                        <Style TargetType="PasswordBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="PasswordBox">
                                        <Border Background="Transparent"
                                                BorderBrush="#36312d"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                            <ScrollViewer x:Name="PART_ContentHost"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </PasswordBox.Style>
                </PasswordBox>
                <TextBlock Text="Passphrase" Foreground="#968d86" FontSize="11" Margin="0,-12,0,24"/>

                <Button x:Name="SubmitBtn" Content="Log In" Background="Transparent"
                        Foreground="#e8e4df" BorderBrush="#e8e4df" BorderThickness="1"
                        Padding="12,10" FontSize="14" Cursor="Hand" Click="Submit_Click" HorizontalAlignment="Stretch">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#e8e4df"/>
                                                <Setter Property="Foreground" Value="#1a1817"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <StackPanel Orientation="Vertical" Margin="0,24,0,0" HorizontalAlignment="Center">
                    <Button x:Name="ToggleModeBtn" Content="Don't have an account? Register"
                            Background="Transparent" BorderThickness="0" Foreground="#968d86"
                            FontSize="13" Cursor="Hand" Click="ToggleMode_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                                       TextDecorations="Underline"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="ForgotBtn" Content="Forgot your password?" Visibility="Visible"
                            Background="Transparent" BorderThickness="0" Foreground="#968d86"
                            FontSize="12" Cursor="Hand" Margin="0,12,0,0" Click="Forgot_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                                       TextDecorations="Underline"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Recovery Key panel -->
            <StackPanel x:Name="RecoveryPanel" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="RecoveryTitle" Text="Your Recovery Key" FontSize="22" FontWeight="Medium"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock x:Name="RecoveryDesc" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="#968d86" FontSize="13" LineHeight="20" Margin="0,0,0,24"
                           Text="This key is the only way to recover your journal if you forget your password. Nobody can reset it for you — that is the honest trade-off of real encryption. Write it down or keep it somewhere safe."/>

                <Border Background="#262321" CornerRadius="8" Padding="24" Margin="0,0,0,24">
                    <TextBlock x:Name="RecoveryKeyLabel" Text="" FontSize="16" FontFamily="Consolas"
                               Foreground="#e8e4df" HorizontalAlignment="Center" TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </Border>

                <Button Content="Download as .txt" Background="Transparent"
                        Foreground="#e8e4df" BorderBrush="#36312d" BorderThickness="1"
                        Padding="12,8" FontSize="13" Cursor="Hand" Click="DownloadRecovery_Click"
                        HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="I have saved this" Background="#e8e4df"
                        Foreground="#1a1817" BorderThickness="0"
                        Padding="16,12" FontSize="14" FontWeight="Medium" Cursor="Hand"
                        Click="RecoverySaved_Click" HorizontalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <!-- Forgot password panel -->
            <StackPanel x:Name="ForgotPanel" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="Reset Password" FontSize="22" FontWeight="Medium"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="#968d86" FontSize="13" LineHeight="20" Margin="0,0,0,24"
                           Text="Enter your email and recovery key to reset your password."/>

                <TextBox x:Name="ForgotEmailBox" Background="Transparent" Foreground="#e8e4df"
                         BorderBrush="#36312d" BorderThickness="1" Padding="12" FontSize="14"
                         Margin="0,0,0,16">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <ScrollViewer x:Name="PART_ContentHost"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <TextBlock Text="Email address" Foreground="#968d86" FontSize="11" Margin="0,-12,0,16"/>

                <TextBox x:Name="RecoveryKeyInput" Background="Transparent" Foreground="#e8e4df"
                         BorderBrush="#36312d" BorderThickness="1" Padding="12" FontSize="14"
                         Margin="0,0,0,16" FontFamily="Consolas">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <ScrollViewer x:Name="PART_ContentHost"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <TextBlock Text="Recovery key (xxxx-xxxx-xxxx-xxxx)" Foreground="#968d86" FontSize="11" Margin="0,-12,0,16"/>

                <PasswordBox x:Name="NewPasswordBox" Background="Transparent" Foreground="#e8e4df"
                             BorderBrush="#36312d" BorderThickness="1" Padding="12" FontSize="14"
                             Margin="0,0,0,16">
                    <PasswordBox.Style>
                        <Style TargetType="PasswordBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="PasswordBox">
                                        <Border Background="Transparent"
                                                BorderBrush="#36312d"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                            <ScrollViewer x:Name="PART_ContentHost"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </PasswordBox.Style>
                </PasswordBox>
                <TextBlock Text="New passphrase" Foreground="#968d86" FontSize="11" Margin="0,-12,0,24"/>

                <TextBlock x:Name="ForgotErrorLabel" Text="" Foreground="#e74c3c" FontSize="13" Margin="0,0,0,16" TextWrapping="Wrap"/>

                <Button Content="Reset Password" Background="Transparent"
                        Foreground="#e8e4df" BorderBrush="#e8e4df" BorderThickness="1"
                        Padding="12,10" FontSize="14" Cursor="Hand" Click="ResetPassword_Click" HorizontalAlignment="Stretch">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="← Back to login" Background="Transparent" BorderThickness="0"
                        Foreground="#968d86" FontSize="12" Cursor="Hand" Margin="0,16,0,0"
                        Click="BackToLogin_Click" HorizontalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                                   TextDecorations="Underline"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
