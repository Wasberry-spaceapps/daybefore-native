<Window x:Class="DayBefore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Day Before" Height="700" Width="1100" MinHeight="500" MinWidth="700"
        Background="#12100e" Foreground="#FFFFFF"
        FontFamily="Georgia, Times New Roman"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" WindowState="Maximized" ResizeMode="CanResizeWithGrip"
        Deactivated="Window_Deactivated" StateChanged="Window_StateChanged">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Grid.Row="0" Background="#0a0908" MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Day Before" Foreground="#666666" FontSize="12"
                       VerticalAlignment="Center" Margin="12,0,0,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="─" Style="{StaticResource TitleBarBtn}" Click="Minimize_Click"/>
                <Button Content="□" Style="{StaticResource TitleBarBtn}" Click="Maximize_Click"/>
                <Button Content="×" Style="{StaticResource TitleBarBtn}" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <!-- Main content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Grid Grid.Column="0" Background="#12100e">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="24,24,24,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Day Before" Foreground="#A0A0A0" FontSize="13" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="New Entry" Style="{StaticResource TextBtn}"
                            Foreground="#FFFFFF" FontWeight="Bold" Click="NewJournal_Click"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,0,24,0">
                        <!-- JOURNAL HISTORY -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="JOURNAL HISTORY" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            <Button x:Name="JournalToggleBtn" Content="hide" Style="{StaticResource TextBtn}" Click="ToggleJournal_Click"/>
                        </Grid>
                        <ListBox x:Name="JournalList" ItemContainerStyle="{StaticResource EntryItem}" SelectionChanged="JournalList_SelectionChanged" Margin="0,0,0,16">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding DisplayDate}" FontSize="12" Foreground="#A0A0A0"/>
                                        <TextBlock Text="{Binding Snippet}" FontSize="13" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- CORE POINTS -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CORE POINTS" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            <Button Content="+" Style="{StaticResource TextBtn}" Margin="0,0,8,0" Click="NewCorePoint_Click"/>
                            <Button x:Name="CoreToggleBtn" Grid.Column="2" Content="hide" Style="{StaticResource TextBtn}" Click="ToggleCore_Click"/>
                        </Grid>
                        <TextBox x:Name="NewCoreNameBox" Visibility="Collapsed" Foreground="#FFFFFF"
                                 Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="#FFFFFF"
                                 Margin="0,0,0,8" FontSize="14" KeyDown="NewCoreName_KeyDown" LostFocus="NewCoreName_LostFocus"/>
                        <ListBox x:Name="CoreList" ItemContainerStyle="{StaticResource EntryItem}" SelectionChanged="CoreList_SelectionChanged" Margin="0,0,0,16">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        <TextBlock Text="{Binding Snippet}" FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- ISSUES -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ISSUES" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            <Button Content="+" Style="{StaticResource TextBtn}" Margin="0,0,8,0" Click="NewIssue_Click"/>
                            <Button x:Name="IssueToggleBtn" Grid.Column="2" Content="hide" Style="{StaticResource TextBtn}" Click="ToggleIssue_Click"/>
                        </Grid>
                        <TextBox x:Name="NewIssueNameBox" Visibility="Collapsed" Foreground="#FFFFFF"
                                 Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="#FFFFFF"
                                 Margin="0,0,0,8" FontSize="14" KeyDown="NewIssueName_KeyDown" LostFocus="NewIssueName_LostFocus"/>
                        <ListBox x:Name="IssueList" ItemContainerStyle="{StaticResource EntryItem}" SelectionChanged="IssueList_SelectionChanged" Margin="0,0,0,16">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        <TextBlock Text="{Binding Snippet}" FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <StackPanel Grid.Row="2" Margin="24,16,24,24">
                    <Rectangle Height="1" Fill="#333333" Margin="0,0,0,16"/>
                    <TextBlock x:Name="SubStatusLabel" Text="" Foreground="#FFFFFF" FontSize="11" Margin="0,0,0,8" Visibility="Collapsed" FontWeight="Medium"/>
                    <Button Content="take a minute" Style="{StaticResource TextBtn}" HorizontalAlignment="Left" Margin="0,0,0,8" Click="Game_Click"/>
                    <Button Content="Export" Style="{StaticResource TextBtn}" HorizontalAlignment="Left" Margin="0,0,0,8" Click="Export_Click"/>
                    <Button x:Name="SubscribeBtn" Content="Subscribe" Style="{StaticResource TextBtn}" HorizontalAlignment="Left" Margin="0,0,0,8" Click="Subscribe_Click" Visibility="Collapsed"/>
                    <Button x:Name="ManageSubBtn" Content="Manage Subscription" Style="{StaticResource TextBtn}" HorizontalAlignment="Left" Margin="0,0,0,8" Click="ManageSubscription_Click" Visibility="Collapsed"/>
                    <Button Content="Log Out" Style="{StaticResource TextBtn}" HorizontalAlignment="Left" Click="LogOut_Click"/>
                </StackPanel>
            </Grid>

            <Rectangle Grid.Column="1" Fill="#333333"/>

            <!-- Main editor area -->
            <Grid Grid.Column="2" Background="#12100e">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" x:Name="ToolbarPanel" Margin="48,32,48,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="EntryTitleBlock" FontSize="15" Foreground="#FFFFFF" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <TextBox x:Name="EntryTitleInput" FontSize="15" Foreground="#FFFFFF" Background="Transparent"
                             BorderThickness="0" FontWeight="Bold" VerticalAlignment="Center" Visibility="Collapsed"
                             TextChanged="EntryTitleInput_TextChanged"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="AutosavedLabel" Text="Autosaved" Foreground="#A0A0A0" FontSize="13" VerticalAlignment="Center" Margin="0,0,16,0" Visibility="Collapsed"/>
                        <Button Content="🗑" Style="{StaticResource TextBtn}" FontSize="16" Click="DeleteEntry_Click"/>
                    </StackPanel>
                </Grid>

                <TextBox x:Name="EditorBox" Grid.Row="1" Margin="48,24,48,48"
                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontSize="17"
                         Foreground="#FFFFFF" Background="Transparent" BorderThickness="0"
                         CaretBrush="#FFFFFF" VerticalContentAlignment="Top" Visibility="Collapsed"
                         TextChanged="EditorBox_TextChanged"/>

                <Grid x:Name="EmptyState" Grid.Row="0" Grid.RowSpan="2">
                    <Button Content="+ Create New Entry" Style="{StaticResource TextBtn}"
                            Foreground="#FFFFFF" FontSize="19"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Click="NewJournal_Click"/>
                </Grid>
            </Grid>

            <!-- Toast -->
            <Border x:Name="ToastPanel" Grid.Column="0" Grid.ColumnSpan="3"
                    Background="#1a1817" BorderBrush="#333333" BorderThickness="1"
                    CornerRadius="8" Padding="20,14" Margin="0,0,0,24"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ToastLabel" Foreground="#A0A0A0" FontSize="14" VerticalAlignment="Center"/>
                    <Button Content="Undo" Style="{StaticResource TextBtn}" Foreground="#FFFFFF" FontWeight="Medium" Margin="16,0,0,0" Click="Undo_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Game overlay -->
        <Grid x:Name="GameOverlay" Grid.Row="0" Grid.RowSpan="2" Background="#12100e" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Button Content="close" Style="{StaticResource TextBtn}" HorizontalAlignment="Right" Margin="24" Click="CloseGame_Click"/>
            <Canvas x:Name="GameCanvas" Grid.Row="1" Background="#12100e" Focusable="True" KeyDown="GameCanvas_KeyDown" MouseDown="GameCanvas_MouseDown"/>
        </Grid>

        <!-- Lock screen -->
        <Grid x:Name="LockOverlay" Grid.Row="0" Grid.RowSpan="2" Background="#1a1817" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
                <TextBlock Text="Day Before" FontSize="28" Foreground="#e8e4df" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Enter your password to continue." FontSize="13" Foreground="#968d86" HorizontalAlignment="Center" Margin="0,0,0,32"/>
                <PasswordBox x:Name="LockPasswordBox" Background="#262321" Foreground="#e8e4df"
                             BorderBrush="#36312d" BorderThickness="1" Padding="12" FontSize="14"
                             Margin="0,0,0,12" KeyDown="LockPassword_KeyDown"/>
                <Button Content="Unlock" Background="#e8e4df" Foreground="#1a1817"
                        Padding="12,8" FontSize="14" Cursor="Hand" Click="Unlock_Click" HorizontalAlignment="Stretch"/>
                <TextBlock x:Name="LockErrorLabel" Text="" Foreground="#e57373" FontSize="12" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <Button Content="← Go Home" Style="{StaticResource TextBtn}" Foreground="#968d86" Margin="0,24,0,0" Click="LockGoHome_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
